<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mnu.sample.mapper.BoardPhotoMapper">
	<!-- 최근 글 n개 리스트 -->
	<select id="boardTopList" resultType="com.mnu.sample.domain.BoardPhotoDTO">
		select * from 
             (select * from tbl_boardphoto order by idx desc)
             <![CDATA[
                    where rownum <= #{num}
             ]]>
             <!-- WHERE rownum &lt;= #{num}  -->
	</select>
	
	<!-- oracle12c 이상 최근 글 n개 리스트 -->
	<select id="boardTopList2" resultType="com.mnu.sample.domain.BoardPhotoDTO">
		SELECT * FROM tbl_boardphoto
                ORDER BY idx DESC
                         FETCH FIRST #{num} ROWS ONLY;
	</select>
	
	<!-- 1. 검색조건에 해당하는 글수 get, post 겸용 -->
	<select id="boardCount" resultType="int">
	     select count(*) from tbl_boardphoto  
	     	<choose>
	     		<when test="search=='name'">
	     			where name like '%'||#{key}||'%'
	     		</when>
	     		<when test="search=='subject'">
	     			where subject like '%'||#{key}||'%'
	     		</when>
	     		<when test="search=='contents'">
	     			where contents like '%'||#{key}||'%'
	     		</when>
	     	</choose>
	</select>

