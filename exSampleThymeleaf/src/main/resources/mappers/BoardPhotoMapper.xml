	<!-- 3. 글 등록 -->
	<insert id="boardWrite">
		insert into tbl_boardphoto(idx, name, email,subject, contents, pass)
		       values(tbl_boardphoto_seq_idx.nextval,#{name},#{email},#{subject},#{contents},#{pass})
	</insert>
	
	<!-- 4. 특정글 조회수 증가 -->
	<update id="boardHits">
		update tbl_boardphoto set readcnt = readcnt + 1 where idx = #{idx}
	</update>
	
	<!-- 5. 특정글 검색(view, 수정) -->
	<select id="boardSelect" resultType="com.mnu.sample.domain.BoardPhotoDTO">
		select * from tbl_boardphoto where idx = #{idx}
	</select>
	
	<!-- 6. 수정처리 -->
	<update id="boardModify">
		update tbl_boardphoto set email=#{email}, subject=#{subject}, contents=#{contents}
						where idx=#{idx} and pass=#{pass}
	</update>
	
	<!-- 7. 삭제처리 -->
	<delete id="boardDelete">
		delete from tbl_boardphoto where idx=#{idx} and pass=#{pass}
	</delete>

</mapper>